# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional Resend API key for live email notifications
RESEND_API_KEY=""

# SENDER_EMAIL: Sender email address for dividend alerts (default: onboarding@resend.dev or verified domain)
SENDER_EMAIL="dividends@example.com"

# MAILING_LIST: Comma-separated email addresses to receive daily alerts
MAILING_LIST="wparajohn@gmail.com"

# CRON_SECRET: Secret authorization token for automated GitHub Action or Vercel cron endpoints
CRON_SECRET="custom_secure_cron_token_123"

# FINANCIAL_API_KEY: Optional Financial Modeling Prep (FMP) or Alpha Vantage API key for institutional live calendar data
FINANCIAL_API_KEY=""
